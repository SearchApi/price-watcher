SEARCHAPI_API_KEY=
PORT=5192
# Optional limits. Defaults shown. Raise them if your SearchApi plan allows.
# PRICE_WATCH_AUTO_CHECK=on        # off pauses automatic checks at startup
# PRICE_WATCH_CHECK_HOURS=24       # hours between automatic checks of each product
# PRICE_WATCH_MAX_PRODUCTS=5       # active products in the watchlist
# PRICE_WATCH_MAX_OBSERVATIONS=60  # saved observations per product
# PRICE_WATCH_HOURLY_LIMIT=30      # local request cap per hour (your account's own limit is used when SearchApi reports it)

# Email alerts through Resend (https://resend.com). All three are optional except the first two.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=Price Watch <onboarding@resend.dev>   # the default only delivers to your own Resend account email
